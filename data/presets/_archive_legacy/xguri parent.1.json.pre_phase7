          "diagnostic_use": [
            "Compare actual parent-library white counts and 3-star white counts by final rank/score band.",
            "Separate quantity of white sparks from usefulness; many off-plan whites are worse than fewer targeted whites."
          ],
          "strategy": [
            "Buy useful skills before the end so they can become white skill candidates.",
            "Win desired race-factor races; losses should not be counted as useful race factors.",
            "Use repeated desired whites in the parent lineage as a positive feature, but apply nonlinear/piecewise diminishing confidence rather than a simple flat linear boost.",
            "Prioritize rare or off-deck whites that cannot easily be obtained from normal support-card pools.",
            "Do not overvalue parents with many irrelevant whites if the desired red/blue/compatibility goals are missing."
          ]
        },
        "scenario_and_hidden_whites": {
          "require_condition_completion": true,
          "lineage_does_not_increase_new_hidden_condition_chance": true,
          "note": "Hidden/new white genes appear only when their run conditions are met; inheriting them in the lineage does not replace meeting those conditions."
        }
      },
      "observed_data_caveats": {
        "hakuraku_room_match_bias": [
          "Room-match and team-trial datasets are observed survivor data, not controlled account-generation logs.",
          "Deleted low-quality characters can bias apparent blue type distribution and low-score spark distributions.",
          "Treat Hakuraku rates as strong priors where sample sizes are large, but prefer local account data when the bot has enough synced parents."
        ],
        "statistical_policy": [
          "Use high-sample observed rates for priors.",
          "Report uncertainty when local sample size is small.",
          "Do not overfit bot routing or skill buying from one run; learn across grouped results."
        ]
      },
      "scenario_parenting_context": {
        "current_global_primary": {
          "scenario": "Make a New Track",
          "alias": "MANT",
          "rating": 5,
          "why": [
            "Current Global legacy counts G1/G2/G3 race overlap, and MANT can stack a very large shared race set.",
            "MANT can reach roughly 50-63 useful overlap wins when the trainee can cover the route.",
            "MANT scenario factors are Stamina and Guts, which are useful parent outputs.",
            "Expected SP is roughly 2000-2500 depending on deck and race load."
          ],
          "constraints": [
            "Mile and medium coverage are very important.",
            "Characters with poor mile access can struggle.",
            "G2/G3-heavy parents are future-fragile after the compatibility rework."
          ]
        },
        "global_early_scenarios": {
          "URA": {
            "current_use": "mostly_early_or_specific_scenario_gene_farming",
            "expected_sp": "launch_1000_plus_post_rework_around_2000",
            "notes": [
              "Hard to consistently produce SS+ parents before later systems.",
              "URA scenario genes give Speed and Stamina style value."
            ]
          },
          "Aoharu": {
            "current_use": "specific_scenario_gene_or_hint_pool",
            "expected_sp": "launch_1000_to_1500_post_rework_around_2000",
            "notes": [
              "More random hints than URA via gauge bursts.",
              "Scenario gene gives Power and Wit style value."
            ]
          },
          "Grand_Live": {
            "current_use": "not_recommended_for_parenting_when_MANT_available",
            "notes": [
              "Low parent-farming value relative to MANT for Global legacy race stacking."
            ]
          }
        },
        "future_or_jp_context": {
          "Grand_Masters": {
            "notes": [
              "Goddess card gives access to useful skills.",
              "Expected SP around 3000.",
              "Not every character benefits equally."
            ]
          },
          "LARC": {
            "notes": [
              "Shortened scenario with lower max compatibility ceiling.",
              "Temporarily raises Turf/Mid aptitude during the scenario but does not make those reds eligible unless natural aptitude is raised.",
              "Useful bridge for limited aptitudes, less useful for max compatibility."
            ]
          },
          "UAF_GFF_Mecha": {
            "notes": [
              "Introduce mini scenario genes instead of old big scenario genes.",
              "GFF can generate broad hint pools via pruning and can reach high SP.",
              "Mecha has less external hint generation than GFF."
            ]
          },
          "Twinkle_Legends": {
            "notes": [
              "Auto-enabled future parent option.",
              "No extra scenario-specific genes beyond the listed scenario output.",
              "Auto results can be very RNG dependent."
            ]
          },
          "Design_Your_Island": {
            "notes": [
              "Strong future auto parent scenario.",
              "High stable floor with strong decks.",
              "Can average roughly 4000-5000 SP depending on deck."
            ]
          },
          "Onsen": {
            "notes": [
              "Can be strong for low G1-only race loads with good decks.",
              "Heavy race rotations can hurt SP and hints.",
              "Race counts above roughly 28-30 can become risky depending on route/deck."
            ]
          },
          "Breeders_Cup": {
            "notes": [
              "Shortened future scenario with route-specific G1 compatibility quirks.",
              "Manual can outperform auto with strong decks.",
              "Auto parenting can suffer due to scenario mechanics and SP/hint constraints."
            ]
          }
        }
      },
      "run_planning_policy": {
        "parent_goal_order": [
          "Define target use: CM, LoH, GGP, GP, main parent, or internal bridge parent.",
          "Define desired pink/red first, especially distance.",
          "Define desired blue stat and deck to support it.",
          "Define desired whites, including rare off-deck skills and key race factors.",
          "Plan compatibility route and overlap with the intended target.",
          "Pick a rental or internal parent that covers missing aptitude, compatibility, or desired skill pool."
        ],
        "race_route_policy": [
          "Current Global parent farms should overlap G1/G2/G3 wins aggressively when the run can still win reliably.",
          "G1 races are highest future-proof value.",
          "G2/G3 are allowed and valuable for current Global compatibility, but should not blindly replace strong training if the target is high-rank/high-white output.",
          "Optional races should be skipped when training is meaningfully better, especially double-rainbow or high-value scenario turns.",
          "Do not use race losses as useful parent data; if the bot cannot win the route, it needs stats/skills/aptitude fixes or alarm clocks."
        ],
        "aptitude_policy": [
          "C aptitude can sometimes win but is not reliable enough for blind race spam.",
          "Raise dirt/mile only when it improves route coverage or target compatibility.",
          "Avoid accidental A-rank unwanted red candidates."
        ],
        "skill_sp_policy": [
          "Buy skills relevant to the target style/distance and race reliability.",
          "Drain SP near career end to maximize rating and white skill candidates.",
          "Skill pruning can improve later hint quality in scenarios where outside/deck hints can be manipulated.",
          "Verify final SP is low; high leftover SP means the parent run is wasting rating and white-gene opportunities."
        ],
        "parent_selection_policy": [
          "Use strong rentals instead of random weak parents.",
          "A parent with many irrelevant whites is not automatically good.",
          "A parent with correct red/blue, strong compatibility, useful whites, and high stats should be preferred over a high-count junk-white parent.",
          "Bot-created parents should be tagged and re-evaluated against manual/user parents for improvement."
        ]
      },
      "optimization_priorities": [
        "Win every attempted race; losses damage parent reliability and reduce useful race-factor evidence.",
        "Prefer broad overlapping G1/G2/G3 wins on current Global legacy, especially MANT parent runs.",
        "Keep final stats high enough to improve blue/green/white star bands; SS score threshold around 17500 materially improves 3-star white/green rates.",
        "Spend SP intelligently before finish; unspent SP is both lost rating and lost skill-factor opportunity.",
        "Track desired 3-star blue, pink, green, and white sparks separately.",
        "Distinguish raw white count from desired/useful white count.",
        "Treat future JP compatibility rules as warnings, not current Global behavior."
      ],
      "desired_spark_categories": {
        "blue": "stat sparks such as Speed, Stamina, Power, Guts, Wit",
        "pink": "aptitude sparks such as Turf, Dirt, Sprint, Mile, Medium, Long, Front Runner, Pace Chaser, Late Surger, End Closer",
        "green": "unique skill sparks",
        "white": "race, skill, scenario, and hidden sparks"
      },
      "learner_diagnostics": {
        "white_spark_rank_diagnostic": {
          "enabled": true,
          "question": "Does this local account's parent library show more or better white sparks at specific final ranks or score bands?",
          "required_data": [
            "parent_library rank",
            "parent_library score",
            "factor list"
          ],
          "minimum_groups": 2,
          "minimum_samples_per_group_for_confidence": 3,
          "outputs": [
            "avg_white_count",
            "avg_3_star_white_count",
            "avg_white_star_total",
            "best_rank_band",
            "sample_size_warning"
          ]
        },
        "guide_vs_observed_data_policy": [
          "Use guide rules as priors.",
          "Use local parent/career logs as observed evidence.",
          "When observed sample size is low, report uncertainty instead of pretending the ML knows."
        ]
      }
    },
