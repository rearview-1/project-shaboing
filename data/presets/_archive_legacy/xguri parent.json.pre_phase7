      ],
      "extraction_policy": {
        "format": "paraphrased_structured_rules",
        "goal": "Give the learner broad parent-farming context: compatibility, race routing, scenario tradeoffs, factor generation, inheritance rates, observed spark-generation rates, rank bands, deck/SP/hint priorities, and diagnostics.",
        "do_not_specialize_only_on": [
          "white_spark_rank_correlation"
        ],
        "use_current_global_rules_first": true,
        "keep_future_jp_rules_as_warnings": true
      },
      "terminology": {
        "parents": "legacy",
        "grandparents": "sub-legacies",
        "factors": "sparks",
        "red": "pink",
        "int": "wit",
        "nige": "front_runner",
        "senkou": "pace_chaser",
        "sashi": "late_surger",
        "oikomi": "end_closer"
      },
      "compatibility_rules": {
        "applies_to": "current_global_pre_2_0",
        "symbols": {
          "great": {
            "label": "double_circle",
            "minimum_points": 151
          },
          "good": {
            "label": "single_circle",
            "minimum_points": 51,
            "maximum_points": 150
          },
          "poor": {
            "label": "triangle",
            "maximum_points": 50
          }
        },
        "overlap_win_grades": [
          "G1",
          "G2",
          "G3"
        ],
        "excluded_overlap_grades": [
          "OP",
          "Pre-OP",
          "Debut"
        ],
        "same_race_duplicate_bonus": false,
        "title_epithet_bonus": true,
        "race_overlap_points": 1,
        "title_epithet_points": 1,
        "lineage_depth_limit": "parents_and_grandparents",
        "individual_link_model": true,
        "overall_symbol_is_sum_of_individual_links": true,
        "parent_to_parent_overlap_current_global": false,
        "race_policy": [
          "For Global legacy, overlap and win as many shared G1/G2/G3 races as practical across the parent line.",
          "Do not count duplicate wins of the same race twice for compatibility.",
          "Do not count OP races for compatibility, even if they can be useful for other goals.",
          "Prioritize double-circle compatibility for parent use; single-circle is a floor, not a target.",
          "Use dirt or additional distance coverage only when it helps bridge compatibility without poisoning desired red-spark eligibility."
        ],
        "future_jp_post_2_0_warning": {
          "applies_to": "future_global_after_2_0_or_current_jp_grand_masters_plus",
          "overlap_win_grades": [
            "G1"
          ],
          "g2_g3_compatibility_removed": true,
          "title_epithet_bonus_removed": true,
          "g1_overlap_points": 3,
          "parent_to_parent_overlap_counts": true,
          "planner_warning": "Parents relying mainly on G2/G3 overlap are excellent for current Global legacy but will lose compatibility value after the rework."
        }
