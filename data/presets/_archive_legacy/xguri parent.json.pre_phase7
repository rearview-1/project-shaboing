      "schema": "sweepy_parent_farming_knowledge_v3",
      "server": "global",
      "compatibility_system": "legacy",
      "source_note": "Structured, paraphrased local notes from Crazyfellow's Parenting & Gene guide plus Hakuraku observed spark research. This stores mechanics, observed rates, and policy rules, not copied article text.",
      "source_files": [
        "Copy of Crazyfellow's Parenting & Gene guide.txt",
        "Copy of Crazyfellow's Parenting & Gene guide.pdf",
        "Copy of Crazyfellow's Parenting & Gene guide.docx",
